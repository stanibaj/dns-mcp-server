# Host IP that the server port is bound to on the Docker host.
# Set to your Tailscale IP (e.g. 100.64.0.1) to expose only on that interface,
# or 127.0.0.1 to keep it localhost-only, or 0.0.0.0 for all interfaces.
BIND_HOST=127.0.0.1

# Port exposed on the Docker host (container always uses 8000 internally).
BIND_PORT=8000
